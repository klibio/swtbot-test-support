Bundle-Description: JUnit Jupiter 5/6 extension capturing screenshots for SWT/SWTBot tests via io.klib.swtbot.support.
-buildpath: \
    io.klib.swtbot.support;version=snapshot,\
    org.eclipse.swt.win32.win32.x86_64;version='[3.135,3.136)',\
    junit-jupiter-api;version='[5.13.4,5.14)',\
    org.opentest4j;version='[1.3,2)',\
    org.apiguardian.api;version='[1.1,2)'
Export-Package: io.klib.swtbot.jupiter;version=0.1.0
Import-Package: org.junit.jupiter.api*;version='[5.13,7)',*
-nojunitosgi: true