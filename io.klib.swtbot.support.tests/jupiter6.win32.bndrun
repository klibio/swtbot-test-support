-include: test.shared.bndrun,test.win32.bndrun
-tester: biz.aQute.tester.junit-platform;version='[7.5,7.6)'
Test-Cases: io.klib.swtbot.smoke.jupiter.ScreenshotSmokeTest
-runrequires.tests: \
    osgi.identity;filter:='(osgi.identity=io.klib.swtbot.support.tests.jupiter)',\
    osgi.identity;filter:='(&(osgi.identity=junit-jupiter-engine)(version>=6.0.1)(!(version>=6.1)))',\
    osgi.identity;filter:='(&(osgi.identity=junit-jupiter-params)(version>=6.0.1)(!(version>=6.1)))',\
    osgi.identity;filter:='(&(osgi.identity=junit-platform-launcher)(version>=6.0.1)(!(version>=6.1)))'
-runblacklist: osgi.identity;filter:='(&(osgi.identity=junit-*)(|(version>=6.1)(!(version>=6.0.1))))'
-runbundles: \
	io.klib.swtbot.jupiter;version='[0.1.0,0.1.1)',\
	io.klib.swtbot.support;version='[0.1.0,0.1.1)',\
	io.klib.swtbot.support.tests.fixture;version=snapshot,\
	io.klib.swtbot.support.tests.jupiter;version=snapshot,\
	junit-jupiter-api;version='[6.0.1,6.0.2)',\
	junit-jupiter-engine;version='[6.0.1,6.0.2)',\
	junit-jupiter-params;version='[6.0.1,6.0.2)',\
	junit-platform-commons;version='[6.0.1,6.0.2)',\
	junit-platform-engine;version='[6.0.1,6.0.2)',\
	junit-platform-launcher;version='[6.0.1,6.0.2)',\
	org.eclipse.swt;version='[3.135.0,3.135.1)',\
	org.eclipse.swt.win32.win32.x86_64;version='[3.135.0,3.135.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)'