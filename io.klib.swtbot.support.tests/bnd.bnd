-sub: fixture.bnd,junit4.bnd,jupiter.bnd
# test bundles are never released
-releaserepo:
-buildpath: \
    io.klib.swtbot.support;version=snapshot,\
    io.klib.swtbot.junit4;version=snapshot,\
    io.klib.swtbot.jupiter;version=snapshot,\
    org.eclipse.swt.win32.win32.x86_64;version='[3.135,3.136)',\
    osgi.core;version='[8,9)',\
    org.junit;version='[4.13.2,5)',\
    junit-jupiter-api;version='[5.13.4,5.14)',\
    junit-jupiter-params;version='[5.13.4,5.14)',\
    junit-jupiter-engine;version='[5.13.4,5.14)',\
    junit-platform-commons;version='[1.13.4,1.14)',\
    junit-platform-engine;version='[1.13.4,1.14)',\
    junit-platform-launcher;version='[1.13.4,1.14)',\
    org.apiguardian.api;version='[1.1,2)'
-nojunitosgi: true