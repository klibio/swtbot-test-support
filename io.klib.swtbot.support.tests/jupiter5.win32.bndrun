-include: test.shared.bndrun,test.win32.bndrun
-tester: biz.aQute.tester.junit-platform;version='[7.5,7.6)'
Test-Cases: io.klib.swtbot.smoke.jupiter.ScreenshotSmokeTest
-runrequires.tests: \
    osgi.identity;filter:='(osgi.identity=io.klib.swtbot.support.tests.jupiter)',\
    osgi.identity;filter:='(&(osgi.identity=junit-jupiter-engine)(version>=5.13.4)(!(version>=5.14)))',\
    osgi.identity;filter:='(&(osgi.identity=junit-jupiter-params)(version>=5.13.4)(!(version>=5.14)))',\
    osgi.identity;filter:='(&(osgi.identity=junit-platform-launcher)(version>=1.13.4)(!(version>=1.14)))'
-runblacklist: \
	osgi.identity;filter:='(&(osgi.identity=junit-jupiter-*)(|(version>=5.14)(!(version>=5.13.4))))',\
	osgi.identity;filter:='(&(osgi.identity=junit-platform-*)(|(version>=1.14)(!(version>=1.13.4))))'
-runbundles: \
	io.klib.swtbot.jupiter;version='[0.1.0,0.1.1)',\
	io.klib.swtbot.support;version='[0.1.0,0.1.1)',\
	io.klib.swtbot.support.tests.fixture;version=snapshot,\
	io.klib.swtbot.support.tests.jupiter;version=snapshot,\
	junit-jupiter-api;version='[5.13.4,5.13.5)',\
	junit-jupiter-engine;version='[5.13.4,5.13.5)',\
	junit-jupiter-params;version='[5.13.4,5.13.5)',\
	junit-platform-commons;version='[1.13.4,1.13.5)',\
	junit-platform-engine;version='[1.13.4,1.13.5)',\
	junit-platform-launcher;version='[1.13.4,1.13.5)',\
	org.eclipse.swt;version='[3.135.0,3.135.1)',\
	org.eclipse.swt.win32.win32.x86_64;version='[3.135.0,3.135.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)'