# ---- Release repositories ------------------------------------------------
# Snapshots go directly to the Sonatype Central Portal snapshot repository
# (CANONICAL=true in CI). Releases land in dist/bundles and are uploaded to
# the Central Portal by .github/scripts/sonatype-upload.sh.
# -------------------------------------------------------------------------

releaserepo: ${workspace}/dist/bundles
sonatype_snapshots: https://central.sonatype.com/repository/maven-snapshots/

# password without username = Bearer token
-connection-settings: \
    server; id=${sonatype_snapshots}; password=${env;SONATYPE_BEARER}; verify=false

-plugin.release: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        name='Release'; \
        releaseUrl='${fileuri;${releaserepo}}'; \
        snapshotUrl='${fileuri;${releaserepo}}'; \
        noupdateOnRelease=true, \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        name='Sonatype Snapshots'; \
        snapshotUrl='${sonatype_snapshots}'; \
        noupdateOnRelease=true

-releaserepo: Release
-releaserepo.sonatype: ${if;${env;CANONICAL};Sonatype Snapshots}
