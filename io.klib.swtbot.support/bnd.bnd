Bundle-Description: SWT-only screenshot support for SWT/SWTBot tests: client-area, window and desktop capture with safe artifact paths and failure guard.
-buildpath: \
    org.eclipse.swt.win32.win32.x86_64;version='[3.135,3.136)'
Export-Package: io.klib.swtbot.support;version=0.1.0
-nojunitosgi: true